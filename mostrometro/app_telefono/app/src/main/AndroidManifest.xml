<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- fotocamera: per leggere il QR delle carte -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- per usare la voce del telefono (sintesi vocale) su Android 11 e successivi -->
    <queries>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>

    <application
        android:label="Mostrometro"
        android:icon="@mipmap/icona"
        android:roundIcon="@mipmap/icona"
        android:allowBackup="true"
        android:theme="@style/Mostro">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- il QR delle carte (http://192.168.4.1/c?n=..&k=..): se la fotocamera del telefono propone
                 "Apri con Mostrometro", la carta si apre direttamente nell'app -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" android:host="192.168.4.1" android:pathPrefix="/c" />
            </intent-filter>
        </activity>
    </application>
</manifest>
